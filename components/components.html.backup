    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>デザインシステムコンポーネントライブラリ</title>
    <link rel="stylesheet" href="../styles/components.css">
</head>
<body>
    <div class="ds-container">
        <h1 class="ds-title">デザインシステムコンポーネントライブラリ</h1>

        <!-- Navigation -->
        <nav class="ds-navigation">
            <div class="ds-navigation__container">
                <div class="ds-navigation__category">
                    <span class="ds-navigation__category-title">🏗️ レイアウト</span>
                    <a href="#main-visual-components">Main Visual</a>
                    <a href="#header-components">Header</a>
                    <a href="#navigation-components">Navigation</a>
                    <a href="#local-navigation-components">Local Nav</a>
                </div>

                <div class="ds-navigation__category">
                    <span class="ds-navigation__category-title">📝 コンテンツ</span>
                    <a href="#text-components">Text</a>
                    <a href="#card-components">Card</a>
                    <a href="#text-card-components">Text Card</a>
                    <a href="#table-components">Table</a>
                    <a href="#list-components">List</a>
                </div>

                <div class="ds-navigation__category">
                    <span class="ds-navigation__category-title">🎯 インタラクション</span>
                    <a href="#button-components">Button</a>
                    <a href="#faq-components">FAQ</a>
                    <a href="#step-components">Step</a>
                    <a href="#info-step-components">Info Step</a>
                </div>
            </div>
        </nav>

        <!-- 🏗️ レイアウト・構造系 -->
        <section class="ds-category">
            <h1 class="ds-category__title">🏗️ レイアウト・構造系</h1>

            <!-- Main Visual Components -->
            <section class="ds-section" id="main-visual-components">
            <h2 class="ds-section__title">Main Visual Components</h2>

            <!-- Mainvisual_01 -->
            <div class="ds-component">
                <h3 class="ds-component__name">Mainvisual_01</h3>
                <div class="ds-component__preview">
                    <div class="c-mainvisual c-mainvisual--01">
                        <div class="c-mainvisual__content">
                            <div class="c-hgroup">
                                <div class="c-hgroup__english">English</div>
                                <div class="c-hgroup__main">
                                    <h1 class="c-hgroup__title">日本語見出し</h1>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            </section>

            <!-- Header Components -->
            <section class="ds-section" id="header-components">
            <h2 class="ds-section__title">Header Components</h2>

            <!-- head/c-hgroup -->
            <div class="ds-component">
                <h3 class="ds-component__name">head/c-hgroup</h3>
                <div class="ds-component__preview">
                    <div class="c-hgroup">
                        <div class="c-hgroup__english">English</div>
                        <div class="c-hgroup__main">
                            <h1 class="c-hgroup__title">日本語見出し</h1>
                        </div>
                    </div>
                </div>
            </div>

            <!-- c-underline-duotone-head -->
            <div class="ds-component">
                <h3 class="ds-component__name">c-underline-duotone-head</h3>
                <div class="ds-component__preview">
                    <div class="c-underline-duotone-head">
                        <h2 class="c-underline-duotone-head__text">見出しテキストが入ります</h2>
                        <div class="c-underline-duotone-head__underline"></div>
                    </div>
                </div>
            </div>

            <!-- c-mark-head -->
            <div class="ds-component">
                <h3 class="ds-component__name">c-mark-head</h3>
                <div class="ds-component__preview">
                    <div class="c-mark-head">
                        <div class="c-mark-head__marker"></div>
                        <h3 class="c-mark-head__text">見出しテキストが入ります</h3>
                    </div>
                </div>
            </div>

            <!-- c-中見出し -->
            <div class="ds-component">
                <h3 class="ds-component__name">c-中見出し</h3>
                <div class="ds-component__preview">
                    <h2 class="c-heading c-heading--x2l">見出しテキスト</h2>
                    <h2 class="c-heading c-heading--x3l">見出しテキスト</h2>
                    <h2 class="c-heading c-heading--x4l">見出しテキスト</h2>
                    <h2 class="c-heading c-heading--x5l">見出しテキスト</h2>
                    <h2 class="c-heading c-heading--x6l">見出しテキスト</h2>
                </div>
            </div>
        </section>

        <!-- Button Components -->
        <section class="ds-section">
            <h2 class="ds-section__title">Button Components</h2>

            <!-- c-subtext-btn -->
            <div class="ds-component">
                <h3 class="ds-component__name">c-subtext-btn</h3>
                <div class="ds-component__preview">
                    <button class="c-subtext-btn c-subtext-btn--round-border">
                        <div class="c-subtext-btn__content">
                            <div class="c-subtext-btn__text">テキスト</div>
                            <div class="c-subtext-btn__subtext">サブテキスト</div>
                        </div>
                        <div class="c-subtext-btn__arrow">
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                                <path d="M6 4L10 8L6 12" stroke="#333" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                    </button>
                </div>
            </div>

            <!-- btn/c-round-ghost-btn -->
            <div class="ds-component">
                <h3 class="ds-component__name">btn/c-round-ghost-btn</h3>
                <div class="ds-component__preview">
                    <button class="c-round-ghost-btn c-round-ghost-btn--default">
                        <span class="c-round-ghost-btn__text">テキスト</span>
                        <div class="c-round-ghost-btn__arrow">
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                                <path d="M6 4L10 8L6 12" stroke="#333" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                    </button>

                    <button class="c-round-ghost-btn c-round-ghost-btn--reverse">
                        <div class="c-round-ghost-btn__arrow c-round-ghost-btn__arrow--left">
