                                <path d="M10 4L6 8L10 12" stroke="#333" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                        <span class="c-round-ghost-btn__text">テキスト</span>
                    </button>

                    <button class="c-round-ghost-btn c-round-ghost-btn--icon-small">
                        <div class="c-round-ghost-btn__icon">
                            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                                <path d="M3.33333 6.66667H16.6667L15 5M3.33333 6.66667L5 5M3.33333 6.66667V15C3.33333 15.442 3.50893 15.866 3.82149 16.1785C4.13405 16.4911 4.55797 16.6667 5 16.6667H15C15.442 16.6667 15.866 16.4911 16.1785 16.1785C16.5911 15.866 16.6667 15.442 16.6667 15V6.66667M8.33333 10H11.6667" stroke="#333" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                        <span class="c-round-ghost-btn__text">テキスト</span>
                        <div class="c-round-ghost-btn__arrow">
                            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                                <path d="M6 4L10 8L6 12" stroke="#333" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                    </button>
                </div>
            </div>
        </section>

        <!-- Card Components -->
        <section class="ds-section">
            <h2 class="ds-section__title">Card Components</h2>

            <!-- card/c-card -->
            <div class="ds-component">
                <h3 class="ds-component__name">card/c-card</h3>
